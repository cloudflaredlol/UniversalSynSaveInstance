+/// Partial-output fallback for a chunk that fails `function_tree_has_residual_control`:
+/// replaces the body of every nested function whose *own* statements still hold
+/// internal control flow with `stub()`, so the rest of the chunk can be emitted as
+/// valid Luau. `stub` receives the unstructured body it replaces. Nested closures
+/// are judged separately, so a good closure inside a good function survives a bad
+/// sibling. The root block is never stubbed; callers must re-check it. Returns how
+/// many functions were stubbed.
+pub fn stub_functions_with_residual_control(block: &Block, stub: &dyn Fn(&Block) -> Block) -> usize {
+    fn own_residual(block: &Block) -> bool {
+        block.0.iter().any(|statement| match statement {
+            Statement::Goto(_)
+            | Statement::Label(_)
+            | Statement::NumForInit(_)
+            | Statement::NumForNext(_)
+            | Statement::GenericForInit(_)
+            | Statement::GenericForNext(_) => true,
+            Statement::If(node) => own_residual(&node.then_block.lock()) || own_residual(&node.else_block.lock()),
+            Statement::While(node) => own_residual(&node.block.lock()),
+            Statement::Repeat(node) => own_residual(&node.block.lock()),
+            Statement::NumericFor(node) => own_residual(&node.block.lock()),
+            Statement::GenericFor(node) => own_residual(&node.block.lock()),
+            _ => false,
+        })
+    }
+
+    fn walk_value(value: &RValue, stub: &dyn Fn(&Block) -> Block, visited: &mut FxHashSet<usize>, stubbed: &mut usize) {
+        if let RValue::Closure(closure) = value {
+            let address = Arc::as_ptr(&closure.function.0) as usize;
+            if visited.insert(address) {
+                let mut function = closure.function.lock();
+                walk_block(&function.body, stub, visited, stubbed);
+                if own_residual(&function.body) {
+                    function.body = stub(&function.body);
+                    *stubbed += 1;
+                }
+            }
+            return;
+        }
+        value.visit_rvalues(&mut |child| {
+            walk_value(child, stub, visited, stubbed);
+            true
+        });
+    }
+
+    fn walk_block(block: &Block, stub: &dyn Fn(&Block) -> Block, visited: &mut FxHashSet<usize>, stubbed: &mut usize) {
+        for statement in &block.0 {
+            crate::deinline::visit_stmt_rvalues(statement, &mut |value| {
+                walk_value(value, stub, visited, stubbed);
+                true
+            });
+            match statement {
+                Statement::If(node) => {
+                    walk_block(&node.then_block.lock(), stub, visited, stubbed);
+                    walk_block(&node.else_block.lock(), stub, visited, stubbed);
+                }
+                Statement::While(node) => walk_block(&node.block.lock(), stub, visited, stubbed),
+                Statement::Repeat(node) => walk_block(&node.block.lock(), stub, visited, stubbed),
+                Statement::NumericFor(node) => walk_block(&node.block.lock(), stub, visited, stubbed),
+                Statement::GenericFor(node) => walk_block(&node.block.lock(), stub, visited, stubbed),
+                _ => {}
+            }
+        }
+    }
+
+    let mut stubbed = 0;
+    walk_block(block, stub, &mut FxHashSet::default(), &mut stubbed);
+    stubbed
+}
