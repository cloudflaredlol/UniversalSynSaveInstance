 /// safe.  The marker is deliberately an invalid internal AST construct; the
 /// final invariant in [`decompile_function`] detects it before output is
 /// returned, so callers cannot mistake a failed function for an empty body.
+/// Opt-in partial output (CLI `--partial`): a nested function that can't be
+/// structured into valid Luau is replaced by [`partial_stub`] instead of failing
+/// the whole chunk. The root function is never stubbed, so a chunk whose main
+/// body is the problem still fails. Process-global because only the CLI sets it.
+pub static PARTIAL_OUTPUT: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// How many functions `--partial` stubbed, for the CLI to report.
+pub static PARTIAL_STUBBED_FUNCTIONS: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+/// The stub says why the function failed. When structuring got far enough to
+/// leave a goto-form body, that body is kept as comments: it can't run (Luau has
+/// no `goto`), but it still shows what the function does.
+fn partial_stub(unstructured: &ast::Block) -> ast::Block {
+    let text = unstructured.to_string();
+    let mut lines = vec![
+        "Tovek --partial: this function could not be decompiled into valid Luau.".to_string(),
+    ];
+    if text.contains("control-flow structuring failed: unsupported certified fallback") {
+        // A failure sentinel: nothing was structured, so only the reason is useful
+        let reason = text.lines().find_map(|line| line.trim().strip_prefix("-- reason: "));
+        lines.push(format!("Reason: {}", reason.unwrap_or("unsupported control flow")));
+    } else {
+        lines.push("Reason: control flow Luau can't express without goto. Its logic, for reading only:".to_string());
+        lines.extend(text.lines().map(|line| format!("  {line}")));
+    }
+    ast::Block::from(lines.into_iter().map(|line| ast::Comment::new(line).into()).collect::<Vec<_>>())
+}
+
+/// [`unsupported_structuring_sentinel`] plus a comment naming why, which
+/// `--partial` stubs show in place of the function.
+fn unsupported_structuring_sentinel_because(reason: &str) -> ast::Block {
+    let mut block = unsupported_structuring_sentinel();
+    block.0.insert(1, ast::Comment::new(format!("reason: {reason}")).into());
+    block
+}
